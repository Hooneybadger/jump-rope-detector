ENVIRONMENT=production
POSTGRES_DB=jump_rope
POSTGRES_USER=jump_rope
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
